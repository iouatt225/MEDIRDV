# ============================================================
# MediRDV CI — Variables d'environnement (Backend API)
# Copier vers .env et renseigner les vraies valeurs.
# NE JAMAIS COMMITTER le fichier .env.
# ============================================================

# --- Flask ---
FLASK_ENV=development
FLASK_DEBUG=1
SECRET_KEY=change-me-in-production
JWT_SECRET_KEY=change-me-jwt-secret

# --- Base de données PostgreSQL ---
DATABASE_URL=postgresql://medirdv:medirdv@postgres:5432/medirdv

# --- Redis ---
REDIS_URL=redis://redis:6379/0

# --- CORS ---
FRONTEND_URL=http://localhost:3000

# --- Celery ---
CELERY_BROKER_URL=redis://redis:6379/1
CELERY_RESULT_BACKEND=redis://redis:6379/2

# --- Minio (S3-compatible) ---
MINIO_ENDPOINT=minio:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=medirdv

# --- Twilio (SMS) — Module 5 ---
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=

# --- SendGrid (Email) — Module 5 ---
SENDGRID_API_KEY=
SENDGRID_FROM_EMAIL=noreply@medirdv.ci

# --- Daily.co (Vidéo) — Module 4 ---
DAILY_API_KEY=
DAILY_API_URL=https://api.daily.co/v1

# --- Sentry (Monitoring) ---
SENTRY_DSN=
